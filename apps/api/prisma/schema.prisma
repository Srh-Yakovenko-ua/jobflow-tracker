generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  light
  dark
  system

  @@map("theme")
}

enum OAuthProvider {
  google
  github

  @@map("oauth_provider")
}

model User {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String         @unique @db.Citext
  passwordHash  String?        @map("password_hash")
  displayName   String?        @map("display_name")
  locale        String         @default("uk")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  settings      UserSettings?
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  captureTokens CaptureToken[]

  @@map("users")
}

model UserSettings {
  userId                String   @id @map("user_id") @db.Uuid
  silenceDays           Int      @default(7) @map("silence_days")
  autoGhostDays         Int?     @default(30) @map("auto_ghost_days")
  askRejectionReason    Boolean  @default(true) @map("ask_rejection_reason")
  monthlySummaryEnabled Boolean  @default(true) @map("monthly_summary_enabled")
  theme                 Theme    @default(system)
  timezone              String   @default("Europe/Kyiv")
  quietHoursStart       DateTime @default(dbgenerated("'22:00:00'::time without time zone")) @map("quiet_hours_start") @db.Time(0)
  quietHoursEnd         DateTime @default(dbgenerated("'08:00:00'::time without time zone")) @map("quiet_hours_end") @db.Time(0)
  notifyInApp           Boolean  @default(true) @map("notify_in_app")
  notifyPush            Boolean  @default(false) @map("notify_push")
  notifyEmail           Boolean  @default(true) @map("notify_email")
  analyticsOptOut       Boolean  @default(false) @map("analytics_opt_out")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  userId         String        @map("user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model CaptureToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("capture_tokens")
}
