generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/diagrams/erd.md"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  light
  dark
  system

  @@map("theme")
}

enum OAuthProvider {
  google
  github

  @@map("oauth_provider")
}

enum Stage {
  applied
  screening
  tech_interview
  final
  offer
  rejected
  ghosted
  withdrawn

  @@map("stage")
}

enum Source {
  djinni
  dou
  robota
  workua
  linkedin
  referral
  company_site
  other

  @@map("source")
}

enum WorkMode {
  remote
  hybrid
  office

  @@map("work_mode")
}

enum RejectionSide {
  company
  candidate
  system

  @@map("rejection_side")
}

enum SearchStatus {
  active
  archived

  @@map("search_status")
}

enum ScheduledEventKind {
  screening_call
  tech_interview
  final_interview
  offer_call
  other

  @@map("scheduled_event_kind")
}

enum ScheduledEventStatus {
  planned
  done
  cancelled

  @@map("scheduled_event_status")
}

enum TimelineEventKind {
  captured
  ai_parsed
  silence_started
  followup_generated
  followup_sent
  interview_scheduled
  interview_done
  note_added
  resume_attached

  @@map("timeline_event_kind")
}

enum ReminderType {
  followup
  interview_soon

  @@map("reminder_type")
}

enum ReminderStatus {
  pending
  done
  snoozed
  dismissed

  @@map("reminder_status")
}

enum NotificationType {
  silence
  interview_soon
  ai_done
  ai_failed
  monthly_summary_ready
  insight_unlocked
  plan_item_due

  @@map("notification_type")
}

enum AiJobStatus {
  queued
  processing
  done
  failed

  @@map("ai_job_status")
}

enum AiResultStatus {
  succeeded
  failed

  @@map("ai_result_status")
}

model User {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String             @unique @db.Citext
  passwordHash      String?            @map("password_hash")
  displayName       String?            @map("display_name")
  locale            String             @default("uk")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  settings          UserSettings?
  refreshTokens     RefreshToken[]
  oauthAccounts     OAuthAccount[]
  captureTokens     CaptureToken[]
  searches          Search[]
  applications      Application[]
  resumes           Resume[]
  resumeVersions    ResumeVersion[]
  aiResults         AiResult[]
  aiJobs            AiJob[]
  reminders         Reminder[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  idempotencyKeys   IdempotencyKey[]
  plans             Plan[]

  @@map("users")
}

model UserSettings {
  userId                String         @id @map("user_id") @db.Uuid
  silenceDays           Int            @default(7) @map("silence_days")
  autoGhostDays         Int?           @default(30) @map("auto_ghost_days")
  askRejectionReason    Boolean        @default(true) @map("ask_rejection_reason")
  monthlySummaryEnabled Boolean        @default(true) @map("monthly_summary_enabled")
  theme                 Theme          @default(system)
  timezone              String         @default("Europe/Kyiv")
  quietHoursStart       DateTime       @default(dbgenerated("'22:00:00'::time without time zone")) @map("quiet_hours_start") @db.Time(0)
  quietHoursEnd         DateTime       @default(dbgenerated("'08:00:00'::time without time zone")) @map("quiet_hours_end") @db.Time(0)
  notifyInApp           Boolean        @default(true) @map("notify_in_app")
  notifyPush            Boolean        @default(false) @map("notify_push")
  notifyEmail           Boolean        @default(true) @map("notify_email")
  analyticsOptOut       Boolean        @default(false) @map("analytics_opt_out")
  activeResumeVersionId String?        @map("active_resume_version_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeResumeVersion   ResumeVersion? @relation(fields: [activeResumeVersionId, userId], references: [id, userId], onDelete: SetNull)

  @@index([activeResumeVersionId, userId])
  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  userId         String        @map("user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model CaptureToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("capture_tokens")
}

model Search {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  title        String
  status       SearchStatus  @default(active)
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz
  finishedAt   DateTime?     @map("finished_at") @db.Timestamptz
  outcome      String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([id, userId])
  @@unique([userId], where: raw("status = 'active'"), map: "searches_user_id_active_key")
  @@index([userId])
  @@map("searches")
}

model Application {
  id              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  searchId        String                   @map("search_id") @db.Uuid
  company         String
  position        String
  url             String?
  source          Source
  salaryMin       Int?                     @map("salary_min")
  salaryMax       Int?                     @map("salary_max")
  currency        String?
  stack           String[]                 @default([])
  location        String?
  workMode        WorkMode?                @map("work_mode")
  currentStage    Stage                    @default(applied) @map("current_stage")
  isDraft         Boolean                  @default(false) @map("is_draft")
  matchScore      Int?                     @map("match_score")
  aiParsed        Json?                    @map("ai_parsed")
  rawText         String?                  @map("raw_text")
  appliedAt       DateTime?                @map("applied_at") @db.Timestamptz
  lastEventAt     DateTime                 @default(now()) @map("last_event_at") @db.Timestamptz
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz
  resumeVersionId String?                  @map("resume_version_id") @db.Uuid
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  search          Search                   @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)
  resumeVersion   ResumeVersion?           @relation(fields: [resumeVersionId, userId], references: [id, userId], onDelete: SetNull)
  stageEvents     StageEvent[]
  timelineEvents  TimelineEvent[]
  contacts        Contact[]
  notes           Note[]
  scheduledEvents ScheduledEvent[]
  aiJobs          AiJob[]
  reminders       Reminder[]

  @@unique([id, userId])
  @@index([userId, currentStage])
  @@index([userId, lastEventAt])
  @@index([searchId, userId])
  @@index([resumeVersionId, userId])
  @@index([searchVector], type: Gin)
  @@map("applications")
}

model StageEvent {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId      String           @map("application_id") @db.Uuid
  fromStage          Stage?           @map("from_stage")
  toStage            Stage            @map("to_stage")
  reasonCode         String?          @map("reason_code")
  comment            String?
  occurredAt         DateTime         @default(now()) @map("occurred_at") @db.Timestamptz
  compensatesEventId String?          @map("compensates_event_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  application        Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reason             RejectionReason? @relation(fields: [reasonCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  compensates        StageEvent?      @relation("StageEventCompensation", fields: [compensatesEventId, applicationId], references: [id, applicationId], onDelete: NoAction, onUpdate: NoAction)
  compensatedBy      StageEvent?      @relation("StageEventCompensation")

  @@unique([id, applicationId])
  @@unique([compensatesEventId, applicationId])
  @@index([applicationId, occurredAt])
  @@index([reasonCode])
  @@map("stage_events")
}

model TimelineEvent {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  kind          TimelineEventKind
  payload       Json              @default("{}")
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@map("timeline_events")
}

model RejectionReason {
  code        String        @id
  side        RejectionSide
  labelUk     String        @map("label_uk")
  labelEn     String        @map("label_en")
  sortOrder   Int           @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  stageEvents StageEvent[]

  @@map("rejection_reasons")
}

model Contact {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  name          String
  role          String?
  email         String?
  telegram      String?
  phone         String?
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("contacts")
}

model Note {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  body          String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("notes")
}

model ScheduledEvent {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId  String               @map("application_id") @db.Uuid
  kind           ScheduledEventKind
  startsAt       DateTime             @map("starts_at") @db.Timestamptz
  durationMin    Int                  @default(60) @map("duration_min")
  locationOrLink String?              @map("location_or_link")
  status         ScheduledEventStatus @default(planned)
  outcomeNote    String?              @map("outcome_note")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  application    Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reminders      Reminder[]

  @@unique([id, applicationId])
  @@index([applicationId, startsAt])
  @@map("scheduled_events")
}

model Resume {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  title     String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  ResumeVersion[]

  @@unique([id, userId])
  @@index([userId])
  @@map("resumes")
}

model ResumeVersion {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  resumeId       String         @map("resume_id") @db.Uuid
  storageKey     String         @unique @map("storage_key")
  filename       String
  mime           String
  sizeBytes      Int            @map("size_bytes")
  title          String
  note           String?
  textExtracted  String?        @map("text_extracted")
  aiProfile      Json?          @map("ai_profile")
  isArchived     Boolean        @default(false) @map("is_archived")
  uploadedAt     DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume         @relation(fields: [resumeId, userId], references: [id, userId], onDelete: Cascade)
  activeSettings UserSettings[]
  applications   Application[]
  aiJobs         AiJob[]

  @@unique([id, userId])
  @@index([userId, resumeId])
  @@map("resume_versions")
}

model AiResult {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  kind          String
  inputHash     String         @map("input_hash")
  promptVersion String         @map("prompt_version")
  output        Json?
  model         String
  tokensIn      Int            @map("tokens_in")
  tokensOut     Int            @map("tokens_out")
  latencyMs     Int            @map("latency_ms")
  status        AiResultStatus
  error         String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiJobs        AiJob[]
  plans         Plan[]

  @@unique([id, userId])
  @@unique([userId, kind, inputHash])
  @@map("ai_results")
}

model AiJob {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  kind            String
  status          AiJobStatus    @default(queued)
  step            Int            @default(0)
  errorType       String?        @map("error_type")
  aiResultId      String?        @map("ai_result_id") @db.Uuid
  applicationId   String?        @map("application_id") @db.Uuid
  resumeVersionId String?        @map("resume_version_id") @db.Uuid
  startedAt       DateTime?      @map("started_at") @db.Timestamptz
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiResult        AiResult?      @relation(fields: [aiResultId, userId], references: [id, userId], onDelete: SetNull)
  application     Application?   @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Cascade)
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([aiResultId, userId])
  @@index([applicationId, userId])
  @@index([resumeVersionId, userId])
  @@map("ai_jobs")
}

model Reminder {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  applicationId    String          @map("application_id") @db.Uuid
  scheduledEventId String?         @map("scheduled_event_id") @db.Uuid
  type             ReminderType
  status           ReminderStatus  @default(pending)
  dueAt            DateTime        @map("due_at") @db.Timestamptz
  snoozedUntil     DateTime?       @map("snoozed_until") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application     @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Cascade)
  scheduledEvent   ScheduledEvent? @relation(fields: [scheduledEventId, applicationId], references: [id, applicationId], onDelete: Cascade)

  @@unique([applicationId, type, scheduledEventId], where: raw("status = ANY (ARRAY['pending'::reminder_status, 'snoozed'::reminder_status])"), map: "reminders_active_key")
  @@index([userId, status, dueAt])
  @@index([applicationId, userId])
  @@index([scheduledEventId, applicationId])
  @@map("reminders")
}

model Notification {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  failedCount   Int       @default(0) @map("failed_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  aggregate   String
  aggregateId String    @map("aggregate_id") @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([createdAt], where: raw("published_at IS NULL"), map: "outbox_unpublished_idx")
  @@map("outbox")
}

model IdempotencyKey {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  key         String
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Plan {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  aiResultId String?    @map("ai_result_id") @db.Uuid
  title      String
  month      DateTime   @db.Date
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiResult   AiResult?  @relation(fields: [aiResultId, userId], references: [id, userId], onDelete: SetNull)
  items      PlanItem[]

  @@index([userId, month])
  @@index([aiResultId, userId])
  @@map("plans")
}

model PlanItem {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  position       Int
  title          String
  why            String?
  expectedEffect String?   @map("expected_effect")
  metric         String?
  dueAt          DateTime? @map("due_at") @db.Timestamptz
  doneAt         DateTime? @map("done_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  plan           Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, position])
  @@map("plan_items")
}
