{
  "name": "@jobflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker -p tsconfig.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsgo -p . --noEmit",
    "test": "vitest run --coverage --project unit",
    "test:int": "vitest run --project int",
    "test:unit": "pnpm run test",
    "test:integration": "pnpm run test:int",
    "test:watch": "vitest watch --project unit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "nest build -p tsconfig.seed.json && node dist-seed/seed.js",
    "demo:seed": "nest build -p tsconfig.seed.json && node dist-seed/demo-seed.js",
    "db:reset": "prisma migrate reset --force && pnpm run db:seed",
    "db:erd": "prisma generate",
    "gen:keys": "node scripts/gen-keys.js",
    "gen:vapid": "node scripts/gen-vapid.js",
    "ai:usage": "nest build -p tsconfig.seed.json && node dist-seed/ai-usage.js",
    "ai:eval": "nest build -p tsconfig.seed.json && node dist-seed/ai-eval.js",
    "ai:rematch": "nest build -p tsconfig.seed.json && node dist-seed/ai-rematch.js",
    "openapi": "node dist/openapi.js ../../docs/api/openapi.json",
    "postinstall": "DISABLE_ERD=true prisma generate"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@bull-board/api": "^9.14.0",
    "@bull-board/express": "^9.14.0",
    "@date-fns/tz": "1.5.0",
    "@jobflow/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "12.6.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/platform-express": "12.6.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.72.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "@sentry/node": "11.17.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.10",
    "bullmq-otel": "^2.0.1",
    "cookie": "^2.0.2",
    "date-fns": "4.4.0",
    "express": "^5.3.0",
    "fflate": "0.8.3",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.17",
    "mjml": "^5.4.1",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "web-push": "4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@jobflow/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.1",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/mjml": "^5.4.2",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "ical.js": "^2.2.1",
    "prisma": "7.10.1",
    "prisma-erd-generator": "3.2.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
