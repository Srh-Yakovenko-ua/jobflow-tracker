{
  "name": "@jobflow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next typegen && eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "thesis:screens": "playwright test -c playwright.thesis.config.ts",
    "defense:record": "pnpm -w demo:seed && playwright test -c playwright.defense.config.ts",
    "sourcemaps:upload": "sentry-cli sourcemaps inject .next/static && sentry-cli --url http://localhost:8003 sourcemaps upload --org jobflow --project jobflow --release \"$NEXT_PUBLIC_SENTRY_RELEASE\" .next/static",
    "typecheck": "next typegen && tsgo -p . --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@fullcalendar/react": "7.1.5",
    "@hookform/resolvers": "6.0.2",
    "@jobflow/bookmarklet": "workspace:*",
    "@jobflow/shared": "workspace:*",
    "@sentry/nextjs": "11.12.0",
    "@tailwind-merge/next": "0.0.0-dev.ab12ab17b7fbc861f04300973065b9f1cff9863b",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "chart.js": "4.6.1",
    "chartjs-chart-sankey": "0.19.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.75.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "sonner": "2.0.8",
    "temporal-polyfill": "1.0.8",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@jobflow/config": "workspace:*",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@sentry/cli": "3.8.2",
    "@tailwind-merge/vite": "0.0.0-dev.ab12ab17b7fbc861f04300973065b9f1cff9863b",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "msw": "3.0.7",
    "postcss": "8.5.33",
