{
  "$meta": {
    "product": "JobFlow",
    "version": "2.0.0",
    "source": "Єдине джерело правди. Веб бере oklch, RN бере hex — значення прораховані з тих самих oklch, а не підібрані окремо.",
    "generates": ["tokens.css", "theme.css", "chart-theme.ts", "rn-theme.ts"]
  },

  "color": {
    "paper": { "oklch": "oklch(97.4% 0.007 78)", "hex": "#F9F6F1", "use": "тло застосунку" },
    "surface": {
      "oklch": "oklch(99.4% 0.004 85)",
      "hex": "#FEFDFA",
      "use": "картка, поповер, модалка"
    },
    "surface-2": {
      "oklch": "oklch(97.2% 0.006 80)",
      "hex": "#F8F5F1",
      "use": "поле, вкладене тло"
    },
    "surface-3": {
      "oklch": "oklch(96% 0.006 80)",
      "hex": "#F4F1ED",
      "use": "сегмент-контрол, заглиблення"
    },
    "line": { "oklch": "oklch(91% 0.008 78)", "hex": "#E4E1DB", "use": "межа контрола" },
    "line-soft": {
      "oklch": "oklch(93.5% 0.008 78)",
      "hex": "#EBE7E1",
      "use": "розділювач, трек шкали"
    },
    "ink": {
      "oklch": "oklch(25% 0.013 62)",
      "hex": "#26201B",
      "use": "основний текст · 13.1:1 на paper"
    },
    "ink-2": { "oklch": "oklch(42% 0.012 62)", "hex": "#524C47", "use": "тіло тексту · 7.4:1" },
    "ink-3": { "oklch": "oklch(50% 0.012 68)", "hex": "#68625C", "use": "підпис, мета · 4.9:1" },
    "accent": {
      "oklch": "oklch(52% 0.12 252)",
      "hex": "#2D6BAB",
      "use": "дія, фокус, посилання · 4.8:1"
    },
    "accent-press": {
      "oklch": "oklch(44% 0.12 252)",
      "hex": "#125492",
      "use": "hover на вебі, pressed у RN"
    },
    "accent-tint": {
      "oklch": "oklch(96.5% 0.014 252)",
      "hex": "#EDF4FD",
      "use": "активний стан, тло бейджа"
    },
    "accent-ink": {
      "oklch": "oklch(38% 0.12 252)",
      "hex": "#0F4A85",
      "use": "текст на accent-tint · 7.1:1"
    },
    "link": {
      "oklch": "oklch(44% 0.12 252)",
      "hex": "#125492",
      "use": "текст дії без заливки: ghost, дія тосту, рядок «+ додати» · 7.6:1"
    },
    "danger": {
      "oklch": "oklch(46% 0.10 34)",
      "hex": "#874131",
      "use": "системна помилка, руйнівна дія, текст помилки поля · 7.3:1"
    },
    "scrim": { "oklch": "oklch(25% 0.013 62)", "hex": "#26201B", "use": "тло під модалкою" }
  },

  "outcome": {
    "offer": {
      "oklch": "oklch(49% 0.10 158)",
      "hex": "#20714A",
      "marker": "коло заповнене",
      "label": "офер"
    },
    "rejected": {
      "oklch": "oklch(58% 0.09 34)",
      "hex": "#A96656",
      "marker": "коло з рискою",
      "label": "відмова",
      "note": "терракота, не червоний; не використовується для системних помилок"
    },
    "ghosted": {
      "oklch": "oklch(78% 0.014 78)",
      "hex": "#BCB6AE",
      "marker": "коло пунктиром",
      "label": "ghosted",
      "note": "знебарвлення, не алерт; не входить у розрахунок конверсій"
    },
    "withdrawn": {
      "oklch": "oklch(58% 0.035 275)",
      "hex": "#747990",
      "marker": "коло з косою",
      "label": "відкликав"
    }
  },

  "stage": {
    "applied": { "oklch": "oklch(38% 0.07 258)", "hex": "#2A4367", "label": "відгук" },
    "screening": { "oklch": "oklch(52% 0.10 235)", "hex": "#1C719A", "label": "скринінг" },
    "tech": { "oklch": "oklch(64% 0.08 195)", "hex": "#499B9B", "label": "техінтерв'ю" },
    "final": { "oklch": "oklch(80% 0.08 80)", "hex": "#D9B982", "label": "фінал" }
  },

  "dataViz": {
    "$note": "Монотонна драбина світлості 38 → 86: у ч/б і при дальтонізмі серії лишаються різними.",
    "data-1": { "oklch": "oklch(38% 0.07 258)", "hex": "#2A4367" },
    "data-2": { "oklch": "oklch(52% 0.10 235)", "hex": "#1C719A" },
    "data-3": { "oklch": "oklch(64% 0.08 195)", "hex": "#499B9B" },
    "data-4": { "oklch": "oklch(72% 0.09 130)", "hex": "#7FA76A" },
    "data-5": { "oklch": "oklch(80% 0.08 80)", "hex": "#D9B982" },
    "data-6": { "oklch": "oklch(86% 0.05 45)", "hex": "#EEC7B6" }
  },

  "font": {
    "display": {
      "family": "Unbounded",
      "weights": [400, 500, 600, 700],
      "license": "OFL",
      "use": "заголовки, великі цифри",
      "tracking": "-0.028em … -0.045em"
    },
    "ui": {
      "family": "Onest",
      "weights": [300, 400, 500, 600, 700],
      "license": "OFL",
      "use": "інтерфейс, тіло тексту",
      "note": "спроєктований під кирилицю"
    },
    "mono": { "family": "ui-monospace", "use": "код у документації системи" }
  },

  "type": {
    "num": {
      "size": 34,
      "lineHeight": 1.0,
      "weight": 600,
      "font": "display",
      "tracking": "-0.04em",
      "numeric": "tabular-nums"
    },
    "display": {
      "size": 21,
      "lineHeight": 1.05,
      "weight": 500,
      "font": "display",
      "tracking": "-0.028em"
    },
    "title": { "size": 16, "lineHeight": 1.3, "weight": 600, "font": "ui", "tracking": "-0.015em" },
    "body-l": { "size": 14.5, "lineHeight": 1.6, "weight": 400, "font": "ui" },
    "body": { "size": 13.5, "lineHeight": 1.55, "weight": 400, "font": "ui" },
    "label": { "size": 12, "lineHeight": 1.4, "weight": 600, "font": "ui" },
    "caption": { "size": 11.5, "lineHeight": 1.5, "weight": 400, "font": "ui" },
    "eyebrow": {
      "size": 11,
      "lineHeight": 1.3,
      "weight": 600,
      "font": "ui",
      "tracking": "0.14em",
      "transform": "uppercase"
    }
  },

  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "14": 56
  },

  "radius": { "xs": 5, "sm": 8, "md": 9, "lg": 12, "xl": 14, "2xl": 16, "3xl": 20, "pill": 999 },

  "control": {
    "xs": { "height": 28, "radius": 8, "fontSize": 12, "padX": 12, "use": "теги, фільтр-чипи" },
    "sm": { "height": 32, "radius": 8, "fontSize": 12.5, "padX": 13, "use": "тулбари, таблиці" },
    "md": { "height": 36, "radius": 9, "fontSize": 13.5, "padX": 16, "use": "дефолт форм" },
    "lg": { "height": 42, "radius": 10, "fontSize": 14.5, "padX": 20, "use": "головна дія, RN" },
    "$rule": "Клікабельна зона добирається падингом до 44px навіть якщо контрол нижчий. У RN мінімум 44pt завжди."
  },

  "elevation": {
    "flat": {
      "web": "inset 0 0 0 1px var(--line)",
      "rn": { "borderWidth": 1, "borderColor": "#E4E1DB" },
      "use": "чипи, поля"
    },
    "e1": {
      "web": "0 1px 2px oklch(25% 0.013 62 / .05), 0 8px 20px -12px oklch(25% 0.013 62 / .14)",
      "rn": {
        "ios": {
          "shadowColor": "#26201B",
          "shadowOpacity": 0.06,
          "shadowRadius": 12,
          "shadowOffset": { "width": 0, "height": 4 }
        },
        "android": { "elevation": 2 }
      },
      "use": "картка"
    },
    "e2": {
      "web": "0 2px 5px oklch(25% 0.013 62 / .06), 0 14px 30px -12px oklch(25% 0.013 62 / .22)",
      "rn": {
        "ios": {
          "shadowColor": "#26201B",
          "shadowOpacity": 0.1,
          "shadowRadius": 20,
          "shadowOffset": { "width": 0, "height": 8 }
        },
        "android": { "elevation": 5 }
      },
      "use": "меню, поповер, ховер картки"
    },
    "e3": {
      "web": "0 4px 10px oklch(25% 0.013 62 / .08), 0 28px 56px -18px oklch(25% 0.013 62 / .34)",
      "rn": {
        "ios": {
          "shadowColor": "#26201B",
          "shadowOpacity": 0.16,
          "shadowRadius": 32,
          "shadowOffset": { "width": 0, "height": 14 }
        },
        "android": { "elevation": 12 }
      },
      "use": "модалка, тост"
    },
    "accent": {
      "web": "0 1px 2px oklch(40% 0.09 252 / .2), 0 8px 18px -7px oklch(40% 0.09 252 / .45)",
      "rn": {
        "ios": {
          "shadowColor": "#125492",
          "shadowOpacity": 0.28,
          "shadowRadius": 14,
          "shadowOffset": { "width": 0, "height": 6 }
        },
        "android": { "elevation": 4 }
      },
      "use": "акцентна кнопка"
    },
    "focus": {
      "web": "0 0 0 2px var(--surface), 0 0 0 4px var(--accent)",
      "rn": "обгортка View з borderWidth 2 + padding 2 (outline у RN немає)",
      "use": "фокус-стан, ніколи не знімається"
    }
  },

  "dark": {
    "$note": "Тепла база, не сине-сіра. Акцент піднятий до 72% L, щоб тримати контраст на темному. Тіней немає — ієрархію тримає світлість поверхонь.",
    "paper": { "oklch": "oklch(22% 0.010 62)", "hex": "#1E1A16" },
    "surface": { "oklch": "oklch(27% 0.011 62)", "hex": "#2A2521" },
    "surface-2": { "oklch": "oklch(31% 0.011 62)", "hex": "#352F2B" },
    "surface-3": { "oklch": "oklch(22% 0.010 62)", "hex": "#1E1A16" },
    "line": { "oklch": "oklch(38% 0.012 65)", "hex": "#47413C" },
    "line-soft": { "oklch": "oklch(38% 0.012 65)", "hex": "#47413C" },
    "ink": { "oklch": "oklch(93% 0.010 80)", "hex": "#EBE7E1" },
    "ink-2": { "oklch": "oklch(80% 0.010 80)", "hex": "#C1BDB7" },
    "ink-3": { "oklch": "oklch(70% 0.012 78)", "hex": "#A39E96" },
    "accent": { "oklch": "oklch(72% 0.12 252)", "hex": "#6AA9EE" },
    "accent-press": { "oklch": "oklch(64% 0.13 252)", "hex": "#4C8FD8" },
    "accent-tint": { "oklch": "oklch(34% 0.05 252)", "hex": "#243951" },
    "accent-ink": { "oklch": "oklch(72% 0.12 252)", "hex": "#6AA9EE" },
    "link": { "oklch": "oklch(72% 0.12 252)", "hex": "#6AA9EE" },
    "danger": { "oklch": "oklch(70% 0.10 34)", "hex": "#D58775" },
    "scrim": { "oklch": "oklch(25% 0.013 62)", "hex": "#26201B" },
    "offer": { "oklch": "oklch(72% 0.13 158)", "hex": "#51BD85" },
    "rejected": { "oklch": "oklch(70% 0.10 34)", "hex": "#D58775" },
    "ghosted": { "oklch": "oklch(52% 0.014 78)", "hex": "#6D6860" },
    "withdrawn": { "oklch": "oklch(66% 0.04 275)", "hex": "#8B91AB" }
  },

  "rn": {
    "$note": "Те, чого у вебі просто немає — а без нього RN-збірка або падає, або виглядає не так.",
    "fonts": {
      "loader": "expo-font + useFonts({ Unbounded_500Medium, Unbounded_600SemiBold, Onest_400Regular, Onest_500Medium, Onest_600SemiBold })",
      "packages": ["@expo-google-fonts/unbounded", "@expo-google-fonts/onest"],
      "$rule": "fontFamily у RN — це ім'я завантаженого файлу, не сімейство: 'Onest_600SemiBold', а не fontWeight: 600."
    },
    "tabularNums": {
      "web": "font-variant-numeric: tabular-nums",
      "rn": "fontVariant: ['tabular-nums']",
      "$rule": "Обов'язково на всіх числах у колонках, score, датах і сумах — інакше цифри стрибають при оновленні."
    },
    "safeArea": {
      "package": "react-native-safe-area-context",
      "$rule": "Топбар і таббар беруть insets.top / insets.bottom; вертикальні падинги екрана — 20, поверх інсетів.",
      "tabBarHeight": 56,
      "headerHeight": 52
    },
    "textScaling": {
      "$rule": "allowFontScaling лишається true. Максимум обмежуємо maxFontSizeMultiplier: 1.4 на компактних контролах (чипи, бейджі), щоб рейка етапів не ламалась."
    },
    "pressState": {
      "$rule": "Pressable з android_ripple: { color: accent-tint } і style({pressed}) → opacity .92, scale .985. Ховера в RN немає — кожен ховер із веба мапиться сюди.",
      "hitSlop": 8
    },
    "interactiveDisabled": {
      "$rule": "Замість web-only cursor модель віддає поле disabled: Pressable disabled + accessibilityState={{ disabled: true }}. Заблокований день календаря не клікається на обох платформах."
    },
    "gap": {
      "$rule": "gap працює з RN 0.71+. Нижче — margin-хелпери; у проєкті мінімум Expo SDK 50 (RN 0.73), тому gap дозволений."
    },
    "reducedMotion": {
      "$rule": "AccessibilityInfo.isReduceMotionEnabled() → всі withTiming(0). Reanimated не читає prefers-reduced-motion сам."
    }
  },

  "motion": {
    "instant": { "duration": 140, "use": "фон, колір" },
    "fast": { "duration": 180, "use": "ховер, тінь, тултіп" },
    "base": { "duration": 200, "use": "поповер, шеврон" },
    "spring": {
      "duration": 260,
      "easing": "cubic-bezier(.34,1.56,.64,1)",
      "use": "модалка, тост, галочка"
    },
    "data": {
      "duration": 820,
      "easing": "easeOutQuart",
      "stagger": 45,
      "use": "вхід серій у чартах"
    },
    "easing": "cubic-bezier(.2,.8,.3,1)",
    "$rule": "prefers-reduced-motion → всі тривалості 0; у RN — AccessibilityInfo.isReduceMotionEnabled."
  },

  "libs": {
    "icons": {
      "web": "lucide-react",
      "rn": "lucide-react-native",
      "props": { "size": [16, 20, 24], "strokeWidth": 1.9, "color": "currentColor" }
    },
    "charts": { "web": "chart.js@4", "rn": "victory-native" },
    "table": {
      "web": "@tanstack/react-table",
      "rn": "@tanstack/react-table + @shopify/flash-list"
    },
    "calendar": { "web": "fullcalendar@6", "rn": "власна сітка на FlatList" },
    "dnd": { "web": "@dnd-kit/core", "rn": "react-native-gesture-handler" },
    "styling": { "web": "tailwindcss", "rn": "nativewind@4" },
    "$rule": "Якщо бібліотека не має RN-аналога — компонент не копіюється, а замінюється іншою метафорою (канбан → рейка етапів, Sankey → вертикальна воронка)."
  },

  "taxonomy": {
    "stages": [
      "відгук",
      "скринінг",
      "техінтерв'ю",
      "фінал",
      "офер",
      "відмова",
      "ghosted",
      "відкликав"
    ],
    "rejectionByCompany": [
      "не вистачає скілів",
      "рівень англійської",
      "зарплатні очікування",
      "обрали іншого",
      "вакансію закрили",
      "без пояснення"
    ],
    "rejectionByMe": ["низька вилка", "офіс/графік", "ред флаги", "прийняв інший офер"],
    "sources": ["Djinni", "DOU", "robota.ua", "LinkedIn", "рефералка", "сайт компанії", "інше"],
    "aiStates": ["у черзі", "обробляється", "готово", "помилка"],
    "$rule": "Match Score 0–100 існує лише після AI-розбору; ручна карточка без CV показує пунктирний прочерк, не нуль."
  },

  "dataRules": {
    "minSampleForPercent": 5,
    "minSampleForInsight": 10,
    "minSampleForForecast": 15,
    "$rule": "Нижче порогу замість відсотка показуємо, скільки записів залишилось до першого висновку."
  }
}
