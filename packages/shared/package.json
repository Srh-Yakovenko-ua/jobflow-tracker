{
  "name": "@jobflow/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens/generated"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enums.json": "./dist/enums.json",
    "./tokens.css": "./tokens/generated/tokens.css",
    "./theme.css": "./tokens/generated/theme.css",
    "./chart-theme": {
      "types": "./dist/chart-theme.d.ts",
      "import": "./dist/chart-theme.js"
    },
    "./rn-theme": {
      "types": "./dist/rn-theme.d.ts",
      "import": "./dist/rn-theme.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/build-tokens.js",
    "build": "tsup && node scripts/export-enums.js",
    "gen:contracts": "node scripts/export-contracts.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsgo -p . --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "tokens:build": "node scripts/build-tokens.js",
    "tokens:check": "node scripts/build-tokens.js --check"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts",
      "chart-theme": "tokens/generated/chart-theme.ts",
      "rn-theme": "tokens/generated/rn-theme.ts",
      "testing": "testing/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jobflow/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
