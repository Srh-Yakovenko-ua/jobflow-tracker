{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2026-00001",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "unrated advisory"
              },
              "fullDescription": {
                "text": "unrated advisory"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Vulnerability CVE-2026-00001\nSeverity: UNKNOWN\nPackage: left-pad\nFixed Version: \nLink: [CVE-2026-00001]()\n",
                "markdown": "**Vulnerability CVE-2026-00001**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|UNKNOWN|left-pad||[CVE-2026-00001]()|\n\n"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "0.0",
                "tags": [
                  "vulnerability",
                  "security",
                  "UNKNOWN"
                ]
              }
            },
            {
              "id": "CVE-2021-23337",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "lodash command injection"
              },
              "fullDescription": {
                "text": "lodash command injection"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Vulnerability CVE-2021-23337\nSeverity: HIGH\nPackage: lodash\nFixed Version: 4.17.21\nLink: [CVE-2021-23337]()\n",
                "markdown": "**Vulnerability CVE-2021-23337**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|HIGH|lodash|4.17.21|[CVE-2021-23337]()|\n\n"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "8.0",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2020-28500",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "lodash ReDoS"
              },
              "fullDescription": {
                "text": "lodash ReDoS"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Vulnerability CVE-2020-28500\nSeverity: LOW\nPackage: lodash\nFixed Version: 4.17.21\nLink: [CVE-2020-28500]()\n",
                "markdown": "**Vulnerability CVE-2020-28500**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|LOW|lodash|4.17.21|[CVE-2020-28500]()|\n\n"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "2.0",
                "tags": [
                  "vulnerability",
                  "security",
                  "LOW"
                ]
              }
            },
            {
              "id": "DS-0026",
              "name": "Misconfiguration",
              "shortDescription": {
                "text": "No HEALTHCHECK defined"
              },
              "fullDescription": {
                "text": "Add a HEALTHCHECK instruction."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Misconfiguration DS-0026\nType: Dockerfile Security Check\nSeverity: MEDIUM\nCheck: No HEALTHCHECK defined\nMessage: Add HEALTHCHECK instruction in your Dockerfile\nLink: [DS-0026]()\nAdd a HEALTHCHECK instruction.",
                "markdown": "**Misconfiguration DS-0026**\n| Type | Severity | Check | Message | Link |\n| --- | --- | --- | --- | --- |\n|Dockerfile Security Check|MEDIUM|No HEALTHCHECK defined|Add HEALTHCHECK instruction in your Dockerfile|[DS-0026]()|\n\nAdd a HEALTHCHECK instruction."
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "5.5",
                "tags": [
                  "misconfiguration",
                  "security",
                  "MEDIUM"
                ]
              }
            },
            {
              "id": "generic-api-key",
              "name": "Secret",
              "shortDescription": {
                "text": "Generic API key"
              },
              "fullDescription": {
                "text": "API_TOKEN=****"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/aquasecurity/trivy/blob/main/pkg/fanal/secret/builtin-rules.go",
              "help": {
                "text": "Secret Generic API key\nSeverity: CRITICAL\nMatch: API_TOKEN=****",
                "markdown": "**Secret Generic API key**\n| Severity | Match |\n| --- | --- |\n|CRITICAL|API_TOKEN=****|"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "9.5",
                "tags": [
                  "secret",
                  "security",
                  "CRITICAL"
                ]
              }
            }
          ],
          "version": "0.76.2"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2026-00001",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "Package: left-pad\nInstalled Version: 1.0.0\nVulnerability CVE-2026-00001\nSeverity: UNKNOWN\nFixed Version: \nLink: [CVE-2026-00001]()"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pnpm-lock.yaml",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": "pnpm-lock.yaml: left-pad@1.0.0"
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2021-23337",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Package: lodash\nInstalled Version: 4.17.20\nVulnerability CVE-2021-23337\nSeverity: HIGH\nFixed Version: 4.17.21\nLink: [CVE-2021-23337]()"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pnpm-lock.yaml",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": "pnpm-lock.yaml: lodash@4.17.20"
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2020-28500",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "Package: lodash\nInstalled Version: 4.17.20\nVulnerability CVE-2020-28500\nSeverity: LOW\nFixed Version: 4.17.21\nLink: [CVE-2020-28500]()"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pnpm-lock.yaml",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": "pnpm-lock.yaml: lodash@4.17.20"
              }
            }
          ]
        },
        {
          "ruleId": "DS-0026",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "Artifact: apps/api/Dockerfile\nType: dockerfile\nVulnerability DS-0026\nSeverity: MEDIUM\nMessage: Add HEALTHCHECK instruction in your Dockerfile\nLink: [DS-0026]()"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "apps/api/Dockerfile",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": "apps/api/Dockerfile"
              }
            }
          ]
        },
        {
          "ruleId": "generic-api-key",
          "ruleIndex": 4,
          "level": "error",
          "message": {
            "text": "Artifact: .env.example\nType: \nSecret Generic API key\nSeverity: CRITICAL\nMatch: API_TOKEN=****"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".env.example",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1,
                  "endLine": 3,
                  "endColumn": 1
                }
              },
              "message": {
                "text": ".env.example"
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "originalUriBaseIds": {
        "ROOTPATH": {
          "uri": "file:///src/trivy-fs.json/"
        }
      }
    }
  ]
}