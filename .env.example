# Docker Compose (INF-05). Root .env is read by compose for interpolation; COMPOSE_FILE removes the need for -f.
COMPOSE_FILE=infra/docker/compose.yml:infra/docker/compose.override.yml

# Postgres superuser password (INF-05), required by the postgres container.
POSTGRES_PASSWORD=postgres
# Password of role jobflow_app (INF-05), must match the password in DATABASE_URL.
POSTGRES_APP_PASSWORD=jobflow_app
# Password of read-only role jobflow_analytics (INF-05), must match the password in DATABASE_URL_ANALYTICS.
POSTGRES_ANALYTICS_PASSWORD=jobflow_analytics

# MinIO root user (INF-05), must match S3_ACCESS_KEY.
MINIO_ROOT_USER=jobflow
# MinIO root password (INF-05), must match S3_SECRET_KEY. URL-safe characters only, no @ : / # (it is embedded in MC_HOST_jobflow).
MINIO_ROOT_PASSWORD=jobflow-minio

# API and worker database (BE-01, BE-11), required. Role jobflow_app.
DATABASE_URL=postgresql://jobflow_app:jobflow_app@localhost:5432/jobflow
# Analytics database (AN-01), required by services/analytics. Read-only role jobflow_analytics.
DATABASE_URL_ANALYTICS=postgresql://jobflow_analytics:jobflow_analytics@localhost:5432/jobflow
# Log level of services/analytics (AN-01), optional, defaults to INFO.
LOG_LEVEL=INFO

# Redis for the BullMQ queues of the API and the worker, and for caches (BE-11, AN-01), required.
REDIS_URL=redis://localhost:6379

# S3-compatible storage for resumes, MinIO locally (BE-29). Endpoint, bucket and keys are required; the region defaults to us-east-1.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=jobflow
S3_SECRET_KEY=jobflow-minio
# The address the browser reaches for presigned upload and download URLs, optional: empty means S3_ENDPOINT. Compose sets it for the api container, whose S3_ENDPOINT is http://minio:9000.
S3_PUBLIC_ENDPOINT=

# RS256 key pair for JWT (BE-07), required. Created by pnpm gen:keys into .secrets/. Paths are relative to apps/api, where the API and worker run.
JWT_PRIVATE_KEY_PATH=../../.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../.secrets/jwt-public.pem

# Service URLs (BE-01, AN-01), required. API_URL is the API's own base URL, ANALYTICS_URL is where the API reaches analytics.
# Analytics reads API_URL too and fetches the signing keys from API_URL/.well-known/jwks.json (AN-03); compose sets http://api:4000 for its container.
API_URL=http://localhost:4000
ANALYTICS_URL=http://localhost:8000
# Runtime mode of the API and the worker (BE-11): development | test | production, optional, defaults to development.
# development turns on Bull Board at /admin/queues, Swagger UI at /api/docs and the dev ping endpoint; the prod image and the CI compose stack run production.
NODE_ENV=development
# Runtime mode of the api container in the CI compose stack (QA-01), optional, defaults to production; the e2e workflow sets test so the dev jobs route answers.
API_NODE_ENV=production
# Address the API binds to (BE-11), optional, defaults to 127.0.0.1 so Bull Board, Swagger UI and the dev ping endpoint stay off the LAN.
# An IP address only; the compose api service sets 0.0.0.0 so its 127.0.0.1:4000 port mapping reaches the container.
HOST=127.0.0.1
# Port the API listens on (BE-01), optional, defaults to 4000.
PORT=4000
# Port of the worker's Prometheus /metrics server (OBS-02), optional, defaults to 9464; 0 picks a free port.
# Worker only and never published to the host: Prometheus scrapes worker:9464 on the compose network, where the worker binds HOST=0.0.0.0.
WORKER_METRICS_PORT=9464
# OTLP endpoint for traces of the api, the worker, analytics and ai (OBS-03), optional. Empty turns tracing off.
# With the observability profile set http://localhost:4318 (Alloy, which forwards to Jaeger); compose rewrites it to http://alloy:4318 for containers.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Browser origin allowed by API CORS and cookies (BE-01) and by analytics CORS (AN-03), required.
WEB_ORIGIN=http://localhost:3000

# Web (FE-03). NEXT_PUBLIC_ values ship to the browser bundle, so no secret ever takes this prefix.
# next dev and next build read both from the process environment; both optional, defaulting to the fixed ports
# http://localhost:4000 and http://localhost:8000. Compose passes none of them.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000
# The browser origin of S3_PUBLIC_ENDPOINT, where the browser sends resume uploads to presigned URLs (SEC-01), optional, defaults to http://localhost:9000.
# The web Content-Security-Policy allows connections only to this origin, the API and analytics.
NEXT_PUBLIC_FILES_URL=http://localhost:9000

# Where the worker reaches services/ai (AI cards), optional, defaults to http://localhost:8001. Vendor keys live in services/ai/.env (AI-01).
AI_SERVICE_URL=http://localhost:8001
# Where the worker posts resume files for text or page images (AI-05, AI-11), optional, defaults to http://localhost:8002.
DOCUMENTS_SERVICE_URL=http://localhost:8002
# AI calls per user per day, optional, defaults to 50.
AI_DAILY_LIMIT=50
# AI tokens in and out across all users per calendar month (UTC), optional, defaults to 1000000 (AI-02).
AI_MONTHLY_TOKEN_CAP=1000000
# USD per million input tokens, the cost column of pnpm ai:usage (AI-02), optional, defaults to 0 while the fake and NVIDIA trial providers are free.
AI_USD_PER_MILLION_TOKENS_IN=0
# USD per million output tokens, the cost column of pnpm ai:usage (AI-02), optional, defaults to 0 while the fake and NVIDIA trial providers are free.
AI_USD_PER_MILLION_TOKENS_OUT=0
# Which file under services/ai the compose ai container reads (FIN-06), optional, defaults to .env; .env.example forces the offline fake provider for the defense demo.
AI_ENV_FILE=.env
# Seconds the fake AI provider waits per call so queued and processing stay visible (FIN-06), optional, defaults to 0; the defense demo uses 3.
AI_FAKE_DELAY_SECONDS=0

# Rate limits, counted in Redis (BE-09). Each window is fixed by the name; the value is how many requests it allows.
# Login attempts per minute per client IP and email (BE-09), optional, defaults to 5.
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Registrations per hour per client IP (BE-09), optional, defaults to 3.
RATE_LIMIT_REGISTER_PER_HOUR=3
# AI requests per hour per user (BE-09), optional, defaults to 30.
RATE_LIMIT_AI_PER_HOUR=30
# Capture requests per hour per capture token (BE-09, keyed by the token from BE-27), optional, defaults to 60.
RATE_LIMIT_CAPTURE_PER_HOUR=60
# Every other request per minute per user, or per client IP before sign-in (BE-09), optional, defaults to 300.
RATE_LIMIT_API_PER_MINUTE=300

# Web push VAPID keys (BE-36), optional, written by pnpm gen:vapid. Empty turns push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Outgoing mail through Mailpit (reminder emails), required. Mailpit is always in the local stack.
SMTP_URL=smtp://localhost:1025

# Error tracking DSN of the api, the worker and analytics (OBS-04), optional. Empty turns error reporting off.
# With the observability profile set http://<GLITCHTIP_DSN_KEY>@localhost:8003/1; compose rewrites it to http://<GLITCHTIP_DSN_KEY>@glitchtip:8000/1 for containers.
SENTRY_DSN=
# Release tag of the api, the worker and analytics events (OBS-04), optional: the git sha (git rev-parse HEAD). Empty sends no release.
SENTRY_RELEASE=
# Error tracking DSN and release of the web, client and Next server (OBS-04), both optional. Empty DSN turns web reporting off.
# next build and next dev read both from the process environment, like NEXT_PUBLIC_API_URL; compose passes none of them.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
# Local GlitchTip (OBS-04, observability profile, http://localhost:8003). Local-only placeholders, like the MinIO and Postgres defaults.
# glitchtip-bootstrap creates the admin, organization and project jobflow (id 1), a DSN key equal to GLITCHTIP_DSN_KEY (32 hex)
# and an API token equal to SENTRY_AUTH_TOKEN (64 hex) that pnpm --filter @jobflow/web sourcemaps:upload uses.
GLITCHTIP_DSN_KEY=3e1d458052fe5e094290f89b928b7db2
GLITCHTIP_SECRET_KEY=36c66ab0deb723a6b013c1d870ce6aa731577e77ec00aab4
GLITCHTIP_ADMIN_EMAIL=admin@jobflow.local
GLITCHTIP_ADMIN_PASSWORD=jobflow-glitchtip
# Password of the glitchtip Postgres role that owns only the glitchtip database; glitchtip-db creates the role and sets it on every run.
GLITCHTIP_DB_PASSWORD=glitchtip
SENTRY_AUTH_TOKEN=6c49ae8c9fe1631175c7809ad8771f561c7b341881423357c73b92f236c86030
# Local Uptime Kuma (OBS-05, observability profile, http://localhost:3002, status page /status/jobflow). Local-only placeholders, like the GlitchTip ones.
# uptime-kuma-bootstrap creates the admin, the monitors, the Telegram channel and the status page; a second run adds only what is missing.
UPTIME_KUMA_ADMIN_USER=admin
UPTIME_KUMA_ADMIN_PASSWORD=JobFlow-kuma-2026
# Token of the worker heartbeat push monitor (32 letters or digits).
UPTIME_KUMA_PUSH_TOKEN=f6c2a9e04b7d4e1a8c3f5b902d6e7a14
# Worker heartbeat URL (OBS-05), optional. Empty turns the heartbeat off.
# With the observability profile set http://localhost:3002/api/push/<UPTIME_KUMA_PUSH_TOKEN>; compose rewrites it to http://uptime-kuma:3001/api/push/<UPTIME_KUMA_PUSH_TOKEN> for containers.
UPTIME_KUMA_PUSH_URL=
# Personal alert bot of Uptime Kuma (OBS-05), optional, separate from the product bot TELEGRAM_BOT_TOKEN (BE-39). Both empty sends no alerts.
UPTIME_KUMA_TELEGRAM_BOT_TOKEN=
UPTIME_KUMA_TELEGRAM_CHAT_ID=
UPTIME_KUMA_TELEGRAM_SERVER_URL=https://api.telegram.org
# Product analytics token for Mixpanel, optional. Empty turns tracking into a no-op.
MIXPANEL_TOKEN=
# Telegram bot token (BE-39), optional. Empty disables the Telegram bot.
TELEGRAM_BOT_TOKEN=

# OAuth sign-in with GitHub and Google (BE-13), optional. Each provider takes both values or neither; half a pair fails at boot.
# Empty turns that provider off: /api/v1/auth/oauth/providers leaves it out and its start route redirects to the web login with oauth=unavailable.
# Callback URLs to register with the OAuth apps: http://localhost:4000/api/v1/auth/oauth/github/callback and http://localhost:4000/api/v1/auth/oauth/google/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
