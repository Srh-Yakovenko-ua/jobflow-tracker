# Docker Compose (INF-05). Root .env is read by compose for interpolation; COMPOSE_FILE removes the need for -f.
COMPOSE_FILE=infra/docker/compose.yml:infra/docker/compose.override.yml

# Postgres superuser password (INF-05), required by the postgres container.
POSTGRES_PASSWORD=postgres
# Password of role jobflow_app (INF-05), must match the password in DATABASE_URL.
POSTGRES_APP_PASSWORD=jobflow_app
# Password of read-only role jobflow_analytics (INF-05), must match the password in DATABASE_URL_ANALYTICS.
POSTGRES_ANALYTICS_PASSWORD=jobflow_analytics

# MinIO root user (INF-05), must match S3_ACCESS_KEY.
MINIO_ROOT_USER=jobflow
# MinIO root password (INF-05), must match S3_SECRET_KEY. URL-safe characters only, no @ : / # (it is embedded in MC_HOST_jobflow).
MINIO_ROOT_PASSWORD=jobflow-minio

# API and worker database (BE-01, BE-11), required. Role jobflow_app.
DATABASE_URL=postgresql://jobflow_app:jobflow_app@localhost:5432/jobflow
# Analytics database (AN-01), required by services/analytics. Read-only role jobflow_analytics.
DATABASE_URL_ANALYTICS=postgresql://jobflow_analytics:jobflow_analytics@localhost:5432/jobflow

# Redis for the BullMQ queues of the API and the worker, and for caches (BE-11, AN-01), required.
REDIS_URL=redis://localhost:6379

# S3-compatible storage for resumes, MinIO locally (BE resume upload), all four required.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=resumes
S3_ACCESS_KEY=jobflow
S3_SECRET_KEY=jobflow-minio

# RS256 key pair for JWT (BE-07), required. Created by pnpm gen:keys into .secrets/. Paths are relative to apps/api, where the API and worker run.
JWT_PRIVATE_KEY_PATH=../../.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../.secrets/jwt-public.pem

# Service URLs (BE-01, AN-01), required. API_URL is the API's own base URL, ANALYTICS_URL is where the API reaches analytics.
API_URL=http://localhost:4000
ANALYTICS_URL=http://localhost:8000
# Runtime mode of the API and the worker (BE-11): development | test | production, optional, defaults to development.
# development turns on Bull Board at /admin/queues and the dev ping endpoint; the prod image and the CI compose stack force production.
NODE_ENV=development
# Port the API listens on (BE-01), optional, defaults to 4000.
PORT=4000
# Browser origin allowed by API CORS and cookies (BE-01), required.
WEB_ORIGIN=http://localhost:3000

# Web (FE-01). NEXT_PUBLIC_ values ship to the browser bundle, so no secret ever takes this prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000

# Where the worker reaches services/ai (AI cards), optional, defaults to http://localhost:8001. Vendor keys live in services/ai/.env (AI-01).
AI_SERVICE_URL=http://localhost:8001
# AI calls per user per day, optional, defaults to 50.
AI_DAILY_LIMIT=50

# Web push keys (push notifications card), optional. Empty turns push into a no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Outgoing mail through Mailpit (reminder emails), required. Mailpit is always in the local stack.
SMTP_URL=smtp://localhost:1025

# Error tracking DSN for GlitchTip (observability cards), optional. Empty disables error reporting.
SENTRY_DSN=
# Product analytics token for Mixpanel, optional. Empty turns tracking into a no-op.
MIXPANEL_TOKEN=
# Telegram bot token (BE-39), optional. Empty disables the Telegram bot.
TELEGRAM_BOT_TOKEN=
