from collections.abc import Iterator

from PIL.Image import Image
from pypdfium2 import raw as raw

class PdfiumError(RuntimeError):
    err_code: int | None

class PdfBitmap:
    def to_pil(self) -> Image: ...

class PdfTextPage:
    def get_text_bounded(self) -> str: ...

class PdfImage:
    def get_px_size(self) -> tuple[int, int]: ...

class PdfPage:
    def get_size(self) -> tuple[float, float]: ...
    def get_objects(
        self, filter: list[int] | None = ..., max_depth: int = ...
    ) -> Iterator[PdfImage]: ...
    def get_textpage(self) -> PdfTextPage: ...
    def render(
        self,
        *,
        scale: float = ...,
        draw_annots: bool = ...,
        may_draw_forms: bool = ...,
    ) -> PdfBitmap: ...

class PdfDocument:
    def __init__(self, input: bytes, password: str | None = None) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> PdfPage: ...
    def close(self) -> None: ...
